@model VillaNumberViewModel

<div class="w-100 card border-0 p-4">
    <!-- card-header -->
    <div class="card-header bg-danger bg-gardient ml-0 py-1">
        <div class="row">
            <div class="col-12 text-center">
                <h2 class="text-white py-2"> Delete Villa Number </h2>
            </div>
        </div>
    </div>
    <!-- end of card-header -->
    <!-- card-body -->
    <div class="card-body border p-2">
        <form method="post" class="row">
            <div class="p-3">
                <input asp-for="VillaNumber.Villa_Number" hidden />
                <!-- Villa Id -->
                <div class="form-floating py-3 col-12">
                    <select asp-for="@Model.VillaNumber.VillaId" asp-items="@Model.VillaList" class="form-select border shadow" disabled>
                        <option disabled selected> -- Select Villa --</option>
                    </select>
                    <label asp-for="VillaNumber.VillaId" class="ms-2"></label>
                    <span asp-validation-for="VillaNumber.VillaId" class="text-danger"></span>
                </div>

                <!-- Villa Number -->
                <div class="form-floating py-3 col-12">
                    <input asp-for="VillaNumber.Villa_Number" class="form-control border shadow" disabled />
                    <label asp-for="VillaNumber.Villa_Number" class="ms-2"></label>
                    <span asp-validation-for="VillaNumber.Villa_Number" class="text-danger"></span>
                </div>

                <!-- Special Details -->
                <div class="form-floating py-3 col-12">
                    <input asp-for="VillaNumber.SpecialDetails" class="form-control border shadow" disabled />
                    <label asp-for="VillaNumber.SpecialDetails" class="ms-2"></label>
                    <span asp-validation-for="VillaNumber.SpecialDetails" class="text-danger"></span>
                </div>

                <!-- Buttons: Create & Cancel -->
                <div class="row pt-2">
                    <div class="vol-6 col-md-3">
                        <button type="submit"
                                class="btn btn-danger w-100">
                            <i class="bi bi-check-circle"></i>
                            Delete
                        </button>
                    </div>

                    <div class="vol-6 col-md-3">
                        <a asp-controller="VillaNumber"
                           asp-action="Index"
                           class="btn btn-secondary w-100">
                            <i class="bi bi-check-circle"></i>
                            Cancel
                        </a>
                    </div>
                </div>
                <!-- end of Buttons div.-->
            </div>
        </form>
    </div>
    <!-- end of card-body -->
</div>

@section Scripts {
    @{
        <partial name="_ValidationScriptsPartial" />
    }
}
