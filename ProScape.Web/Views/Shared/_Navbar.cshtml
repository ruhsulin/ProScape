@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<nav class="navbar navbar-expand-sm" box-shadow>
    <div class="container-fluid">
        <!-- Logo -->
        <a class="navbar-brand" href="#">
            <h2 class="text-logo"><span class="text-pro">Pro</span>Scape</h2>
        </a>
        <!-- End of Logo -->

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarColor01" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Other Links -->
        <div class="collapse navbar-collapse justify-content-end">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link"
                       asp-area=""
                       asp-controller="Home"
                       asp-action="Index">
                        Home
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link"
                       asp-area=""
                       asp-controller="Villa"
                       asp-action="Index">
                        Villas
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link"
                       asp-area=""
                       asp-controller="VillaNumber"
                       asp-action="Index">
                        Villa Numbers
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link"
                       asp-area=""
                       asp-controller="Amenity"
                       asp-action="Index">
                        Amenities
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link"
                       asp-area=""
                       asp-controller="Booking"
                       asp-action="Index"
                       asp-route-status="@StaticDetails.StatusApproved">
                        Booking
                    </a>
                </li>
                <!-- Checking if user is signed in -->
                @if (SignInManager.IsSignedIn(User))
                {
                    <!-- User's name -->
                    <li class="nav-item p-1">
                        <a class="nav-link btn-login-outline"
                           asp-area=""
                           asp-controller="Account"
                           asp-action="LogOut">
                            Hi, @UserManager.GetUserName(User)!
                        </a>
                    </li>
                    <!-- LogOut -->
                    <li class="nav-item p-1">
                        <a class="nav-link btn-login-outline"
                           asp-area=""
                           asp-controller="Account"
                           asp-action="LogOut">
                            LogOut
                        </a>
                    </li>
                }
                else
                {
                    <!-- LogIn -->
                    <li class="nav-item p-1">
                        <a class="nav-link btn-login-outline"
                           asp-area=""
                           asp-controller="Account"
                           asp-action="Login">
                            Login
                        </a>
                    </li>
                }

            </ul>
        </div>
    </div>
</nav>