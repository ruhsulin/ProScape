@model HomeViewModel

<div>
    @* HomePage - Carousel *@
    <div id="carouselExampleIndicators" class="carousel slide">
        <div class="carousel-indicators">
            <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
            <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="1" aria-label="Slide 2"></button>
            <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="2" aria-label="Slide 3"></button>
        </div>

        @* Carousel Images *@
        <div class="carousel-inner">
            <div class="carousel-item active">
                <img src="~/img/AppImages/Slide1.jpg" class="d-block w-100" alt="...">
            </div>
            <div class="carousel-item">
                <img src="~/img/AppImages/Slide2.jpg" class="d-block w-100" alt="...">
            </div>
            <div class="carousel-item">
                <img src="~/img/AppImages/Slide3.jpg" class="d-block w-100" alt="...">
            </div>
        </div>

        @* Carousel Buttons *@
        <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>

        <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>

    </div>
    @* End of Caoursel *@

    <form method="post" asp-action="GetVillasByDate">
        <!-- Row for: CheckinDate, Nights number & Check availability -->
        <div class="row p-0 mx-0 py-4">
            @* Checkin Date *@
            <div class="col-lg-4 col-md-4 col-sm-3 offset-md-1 pl-2  pr-2 pr-md-0">
                <div class="form-group">
                    <label>Check In Date</label>
                    <input asp-for="CheckInDate" type="date" class="form-control" />
                </div>
            </div>   
            @* End of checkin Date *@
          

            @* Nights number *@
            <div class="col-lg-3 col-md-3 col-sm-3 pl-2 pr-2">
                <div class="form-group">
                    <label>No. of nights</label>
                    <select class="form-select" asp-for="Nights">
                        @for (var i = 1; i < 11; i++)
                        {
                            <option value="@i">@i</option>
                        }
                    </select>
                </div>
            </div> 
            @* End of nights number *@
            

            @* Button: Check availability *@
            <div class="col-lg-4 col-md-4 col-sm-6 pt-4 pr-2">
                <div class="form-group">
                    <button type="button" onclick="loadVillaList()" class="btn btn-1 btn-block">
                        <i class="bi bi-search"></i>  &nbsp; Check Availability
                    </button>

                </div>
            </div>
            @* End of button *@
        </div>
        <!-- End of: CheckinDate, Nights number & Check availability -->

        <!-- Displaying Villas  -->
        <partial name="_VillaList" model="Model" />
    </form>
</div>

@section scripts {
    <script>
        function loadVillaList() {
            $('.spinner').show();

            var objData = {
                checkInDate: $("#CheckInDate").val(),
                nights: $("#Nights").val()
            };

            $.ajax({
                url: "@Url.Action("GetVillasByDate", "Home")",
                data: objData,
                type: "POST",
                success: function (data) {
                    $("#VillasList").empty();
                    $("#VillasList").html(data);
                    $('.spinner').hide();
                },
                failure: function(response){
                    $('.spinner').hide();
                    alert(response.responseText);
                },
                error: function (response) {
                    $('.spinner').hide();
                    alert(response.responseText);
                },


            });
        }    
    </script>
}